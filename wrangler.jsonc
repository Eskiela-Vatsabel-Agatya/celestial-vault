{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celestial-vault",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Static files come from the Vite build. Only /api/* wakes the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "celestial-vault-db",
      "database_id": "5bda8626-50ce-4eca-9d50-8def1950f7c1"
    }
  ],
  "observability": { "enabled": true },
  // Public Turnstile site key (not secret). The secrets go in the Cloudflare dashboard, never here.
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFZBGQRih_nEMzX-" }
}
